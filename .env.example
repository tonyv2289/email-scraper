# Microsoft Azure AD App Registration
# Create an app at https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
# Required API Permissions: Mail.Read, Mail.ReadBasic, User.Read

CLIENT_ID=your-azure-app-client-id
TENANT_ID=your-azure-tenant-id

# Optional: For confidential client apps (service accounts)
# CLIENT_SECRET=your-client-secret

# Output settings
OUTPUT_DIR=./output
